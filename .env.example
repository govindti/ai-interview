# Database (PostgreSQL via Docker)
# Run: bun run db:up
DATABASE_URL=postgresql://user:password@localhost:5432/ai_interview

# AI Services
# Required - Voice interview via OpenAI Realtime API
OPENAI_KEY=your_openai_api_key

# Optional - Interview evaluation via Gemini (if not set, falls back to OpenAI GPT-4)
GEMINI_API_KEY=your_gemini_api_key

# Optional
NODE_ENV=development
PORT=3001
PROXY_URL=

# LinkedIn Scraper (optional)
LINKEDIN_TIMEOUT_MS=45000
LINKEDIN_USER_AGENT=
HEADLESS=true
DATAIMPULSE_PROXY_URL=
DATAIMPULSE_PROXY_USERNAME=
DATAIMPULSE_PROXY_PASSWORD=
